# ── hr-social environment ──────────────────────────────────────────────
# Copy to .env (PM2 reads it via --env-file or your ecosystem config) and fill in.

# Anthropic API key — used by the "Draft a week" feature only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the drafting model (defaults to claude-opus-4-8).
# HR_SOCIAL_MODEL=claude-opus-4-8

# Server bind. Default 127.0.0.1:3955 — only the Cloudflare tunnel should reach it.
# HR_SOCIAL_HOST=127.0.0.1
# HR_SOCIAL_PORT=3955

# Default local hour (24h) used when scheduling drafted posts. Default 17 (5pm).
# HR_SOCIAL_POST_HOUR=17

# Graph API version. Default v21.0.
# HR_GRAPH_VERSION=v21.0

# Safety: when 1, the cron and "Post now" simulate posting (no Graph API call).
# Use this for the first dry walk-through before going live.
# HR_SOCIAL_DRY_RUN=0

# ── Accounts ───────────────────────────────────────────────────────────
# JSON array of accounts. Each needs: key, name, ig_user_id, fb_page_id,
# and a token_env naming the env var that holds the Graph access token
# (kept out of this JSON so tokens never sit in the accounts blob or the DB).
#
# HR_SOCIAL_ACCOUNTS=[{"key":"happilyrunning","name":"Happily Running","ig_user_id":"1784xxxxxxxxxxx","fb_page_id":"1234567890","token_env":"HR_TOKEN_HAPPILYRUNNING","platforms":["instagram","facebook"]}]

# The actual long-lived token, referenced by token_env above:
# HR_TOKEN_HAPPILYRUNNING=EAAG...
